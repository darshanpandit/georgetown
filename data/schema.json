{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Travel Molecule Dataset",
  "description": "Schema for travel molecule visualization data format",
  "type": "object",
  "required": ["nodes", "links"],
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "source": { "type": "string", "description": "Data source name" },
        "sourceUrl": { "type": "string", "format": "uri" },
        "year": { "type": "integer" },
        "region": { "type": "string" },
        "methodology": { "type": "string" },
        "sampleSize": { "type": "integer" },
        "lastUpdated": { "type": "string", "format": "date" },
        "units": {
          "type": "object",
          "properties": {
            "share": { "type": "string", "enum": ["proportion", "percentage", "count"] },
            "weight": { "type": "string", "enum": ["proportion", "percentage", "count"] }
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "share"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z_]+$" },
          "label": { "type": "string" },
          "share": { "type": "number", "minimum": 0, "maximum": 1 },
          "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "description": { "type": "string" },
          "category": { "type": "string" }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target", "weight"],
        "properties": {
          "source": { "type": "string" },
          "target": { "type": "string" },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 },
          "label": { "type": "string" },
          "mode": { "type": "string" },
          "modeColor": { "type": "string" }
        }
      }
    }
  }
}
